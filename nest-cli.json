{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/event-api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "webpackConfigPath": "webpack.config.js",
    "tsConfigPath": "apps/event-api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/event-api",
  "projects": {
    "administrative-api": {
      "type": "application",
      "root": "apps/administrative-api",
      "entryFile": "main",
      "sourceRoot": "apps/administrative-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/administrative-api/tsconfig.app.json"
      }
    },
    "auth-api": {
      "type": "application",
      "root": "apps/auth-api",
      "entryFile": "main",
      "sourceRoot": "apps/auth-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-api/tsconfig.app.json"
      }
    },
    "event-api": {
      "type": "application",
      "root": "apps/event-api",
      "entryFile": "main",
      "sourceRoot": "apps/event-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/event-api/tsconfig.app.json"
      }
    }
  }
}
